generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local emergency fallback: SQLite (no Docker required).
  // Production: change provider to "postgresql" and use docker-compose Postgres:
  // DATABASE_URL="postgresql://bodiqo:bodiqo@localhost:5432/bodiqo?schema=public"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentProvider {
  PAYPAL
  STRIPE
  CRYPTO
  MANUAL
}

enum CryptoPaymentStatus {
  WAITING
  CONFIRMING
  CONFIRMED
  EXPIRED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role           @default(USER)
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  addresses     Address[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  sortOrder   Int        @default(0)
  enabled     Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([enabled, sortOrder])
}

model Supplier {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  website             String?
  notes               String?
  defaultShippingDays Int       @default(12)
  currency            String    @default("USD")
  enabled             Boolean   @default(true)
  products            Product[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Future marketplace seller hook (Phase 5+) — unused by storefront in v1.
model Seller {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String?
  enabled   Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  products  ProductTag[]
  createdAt DateTime     @default(now())
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  image       String?
  enabled     Boolean             @default(true)
  sortOrder   Int                 @default(0)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  description        String
  shortDescription   String
  price              Decimal
  compareAt          Decimal?
  costPrice          Decimal?
  currency           String              @default("ILS")
  sku                String              @unique
  barcode            String?
  brand              String?
  vendor             String              @default("BODIQO")
  images             Json
  videoUrl           String?
  featured           Boolean             @default(false)
  enabled            Boolean             @default(true)
  status             ProductStatus       @default(PUBLISHED)
  inStock            Boolean             @default(true)
  inventory          Int                 @default(100)
  reserved           Int                 @default(0)
  soldCount          Int                 @default(0)
  weightGrams        Int?
  seoTitle           String?
  seoDescription     String?
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  sellerId           String?
  seller             Seller?             @relation(fields: [sellerId], references: [id])
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  supplierProductUrl String?
  supplierProductId  String?
  supplierSku        String?
  markupPercent      Decimal             @default(40)
  dropshipEnabled    Boolean             @default(true)
  lastCostSyncAt     DateTime?
  variants           ProductVariant[]
  orderItems         OrderItem[]
  reviews            Review[]
  tags               ProductTag[]
  collections        ProductCollection[]
  wishlist           WishlistItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([enabled, featured])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([sellerId])
  @@index([brand])
  @@index([soldCount])
  @@index([createdAt])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  sku         String      @unique
  options     Json?
  price       Decimal
  compareAt   Decimal?
  costPrice   Decimal?
  inventory   Int         @default(0)
  inStock     Boolean     @default(true)
  image       String?
  supplierSku String?
  supplierUrl String?
  enabled     Boolean     @default(true)
  sortOrder   Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  zip       String?
  country   String   @default("IL")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Decimal
  minSubtotal Decimal?
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  country   String
  region    String?
  rate      Decimal
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, enabled])
}

model Order {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])
  email              String
  status             OrderStatus    @default(PENDING)
  subtotal           Decimal
  shipping           Decimal
  discount           Decimal        @default(0)
  tax                Decimal        @default(0)
  total              Decimal
  currency           String         @default("ILS")
  couponCode         String?
  shippingName       String
  shippingPhone      String?
  shippingAddress    String
  shippingCity       String
  shippingZip        String?
  shippingCountry    String         @default("IL")
  trackingNumber     String?
  carrier            String?
  shippedAt          DateTime?
  customerNotes      String?
  adminNotes         String?
  notes              String?
  paymentProvider    PaymentProvider?
  paypalOrderId      String?
  paypalCaptureId    String?
  stripeSessionId    String?
  stripePaymentIntent String?
  paidAt             DateTime?
  fulfillStatus      String         @default("UNFULFILLED")
  supplierOrderId    String?
  supplierOrderedAt  DateTime?
  items              OrderItem[]
  payments           Payment[]
  cryptoPayments     CryptoPayment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([email])
  @@index([fulfillStatus])
  @@index([paymentProvider])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  title       String
  slug        String
  image       String?
  price       Decimal
  quantity    Int
  costPrice   Decimal?
  supplierUrl String?
  supplierSku String?
}

model Payment {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  externalId String?
  amount     Decimal
  currency   String
  status     String
  raw        Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([orderId])
  @@index([provider, status])
}

model CryptoPayment {
  id        String              @id @default(cuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coin      String
  network   String
  amount    Decimal
  currency  String              @default("USD")
  address   String
  txid      String?
  status    CryptoPaymentStatus @default(WAITING)
  expiresAt DateTime?
  confirmedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([coin])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  title     String?
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, approved])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  href      String
  sortOrder Int        @default(0)
  enabled   Boolean    @default(true)
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  location  String     @default("header")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int       @default(0)
  enabled   Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ImportJob {
  id          String   @id @default(cuid())
  source      String
  status      String   @default("pending")
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  log         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String?
  entityId   String?
  summary    String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entity])
}

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  relativePath String
  sizeBytes   Int      @default(0)
  format      String   @default("json")
  trigger     String   @default("manual")
  status      String   @default("ready")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
