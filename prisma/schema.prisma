generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  MODERATOR
  ADMIN
  OWNER
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
  DELETED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  SHORT
  POLL
  LINK
  REPOST
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PostStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
  DELETED
}

enum MediaKind {
  IMAGE
  VIDEO
  GIF
  VOICE
  DOCUMENT
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPLY
  MENTION
  SHARE
  FRIEND_REQUEST
  VERIFICATION
  COMMUNITY_INVITE
  STORY_REPLY
  MESSAGE
  CALL
  MISSED_CALL
  GROUP_INVITE
}

enum ReportTarget {
  USER
  POST
  COMMENT
  STORY
  MESSAGE
  COMMUNITY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PresenceStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
  INVISIBLE
  IN_CALL
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  DOCUMENT
  GIF
  LOCATION
  CONTACT
  LINK
  SYSTEM
}

enum MessageDelivery {
  SENT
  DELIVERED
  SEEN
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  FAILED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityJoinStatus {
  JOINED
  PENDING
  INVITED
  BANNED
}

enum PrivacyAudience {
  EVERYONE
  FOLLOWERS
  FOLLOWING
  MUTUAL
  NOBODY
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  emailVerified    DateTime?
  phone            String?         @unique
  phoneVerified    DateTime?
  name             String?
  displayName      String?
  image            String?
  coverImage       String?
  passwordHash     String?
  role             Role            @default(USER)
  status           AccountStatus   @default(PENDING)
  trustScore       Int             @default(100)
  handle           String?         @unique
  bio              String?
  website          String?
  country          String?
  city             String?
  birthday         DateTime?
  locale           String          @default("en")
  theme            ThemePreference @default(SYSTEM)
  isPrivate        Boolean         @default(false)
  isVerified       Boolean         @default(false)
  isOfficial       Boolean         @default(false)
  onboardingDone   Boolean         @default(false)
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  twoFactorPending String?
  sessionVersion   Int             @default(0)
  passwordChangedAt DateTime?
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  bannedUntil      DateTime?
  banReason        String?
  warningCount     Int             @default(0)
  followersCount   Int             @default(0)
  followingCount   Int             @default(0)
  postsCount       Int             @default(0)
  videosCount      Int             @default(0)
  storiesCount     Int             @default(0)
  presence         PresenceStatus  @default(OFFLINE)
  lastSeenAt       DateTime?
  accounts         Account[]
  sessions         Session[]
  deviceSessions   DeviceSession[]
  loginHistory     LoginHistory[]
  trustedDevices   TrustedDevice[]
  backupCodes      TwoFactorBackupCode[]
  phoneOtps        PhoneOtp[]
  emailTokens      EmailToken[]
  authChallenges   AuthChallenge[]
  posts            Post[]          @relation("AuthorPosts")
  comments         Comment[]
  likes            PostLike[]
  commentLikes     CommentLike[]
  bookmarks        Bookmark[]
  followers        Follow[]        @relation("Following")
  following        Follow[]        @relation("Follower")
  blocksIssued     Block[]         @relation("Blocker")
  blocksReceived   Block[]         @relation("Blocked")
  mutesIssued      Mute[]          @relation("Muter")
  mutesReceived    Mute[]          @relation("Muted")
  restrictsIssued  Restrict[]      @relation("Restrictor")
  restrictsReceived Restrict[]     @relation("Restricted")
  reportsIssued    Report[]        @relation("Reporter")
  friendRequestsSent     FriendRequest[] @relation("FriendFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendTo")
  notifications    Notification[]  @relation("NotifyUser")
  actorNotifications Notification[] @relation("NotifyActor")
  pushSubscriptions PushSubscription[]
  stories          Story[]
  storyViews       StoryView[]
  storyReactions   StoryReaction[]
  interests        UserInterest[]
  pollVotes        PollVote[]
  searchHistory    SearchHistory[]
  privacy          PrivacySettings?
  conversationMembers ConversationMember[]
  messagesSent     Message[]       @relation("MessageSender")
  messageReactions MessageReaction[]
  messageHides     MessageHide[]
  callsInitiated   Call[]          @relation("CallCaller")
  callParticipants CallParticipant[]
  communityMembers CommunityMember[]
  communitiesOwned Community[]     @relation("CommunityOwner")
  communityPosts   CommunityPost[] @relation("CommunityPostAuthor")
  userNotes        UserNote[]      @relation("UserNotes")
  authoredNotes    UserNote[]      @relation("NoteAuthor")
  userWarnings     UserWarning[]   @relation("UserWarnings")
  issuedWarnings   UserWarning[]   @relation("WarningIssuer")
  verificationRequests VerificationRequest[]
  mediaAssets      MediaAsset[]
  encryptionKey    UserEncryptionKey?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([handle])
  @@index([isVerified])
  @@index([followersCount])
  @@index([presence, lastSeenAt])
  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([lastSeenAt])
}

model UserEncryptionKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  publicKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([userId])
}

model TwoFactorBackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneOtp {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  purpose   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

model AuthChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String
  meta      Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey   String   @unique
  deviceLabel  String?
  userAgent    String?
  ip           String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([userId, revokedAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ip        String?
  userAgent String?
  provider  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([userId, fingerprint])
}

model Interest {
  id    String         @id @default(cuid())
  slug  String         @unique
  name  String
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  fromUser   User                @relation("FriendFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User                @relation("FriendTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId, createdAt])
}

model Mute {
  id       String   @id @default(cuid())
  muterId  String
  mutedId  String
  muter    User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted    User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([mutedId])
  @@index([muterId, createdAt])
}

model Report {
  id          String         @id @default(cuid())
  reporterId  String
  reporter    User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTarget
  targetId    String
  reason      String
  category    ReportCategory @default(OTHER)
  details     String?
  status      ReportStatus   @default(OPEN)
  assigneeId  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([category, status])
}

enum ReportCategory {
  SPAM
  FAKE_ACCOUNT
  SCAM
  HARASSMENT
  COPYRIGHT
  NUDITY
  VIOLENCE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

model Post {
  id              String         @id @default(cuid())
  authorId        String
  author          User           @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade)
  type            PostType       @default(TEXT)
  status          PostStatus     @default(PUBLISHED)
  visibility      PostVisibility @default(PUBLIC)
  body            String         @default("")
  linkUrl         String?
  commentsEnabled Boolean        @default(true)
  isPinned        Boolean        @default(false)
  likeCount       Int            @default(0)
  commentCount    Int            @default(0)
  shareCount      Int            @default(0)
  bookmarkCount   Int            @default(0)
  viewCount       Int            @default(0)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  originalPostId  String?
  originalPost    Post?          @relation("Reposts", fields: [originalPostId], references: [id])
  reposts         Post[]         @relation("Reposts")
  media           PostMedia[]
  likes           PostLike[]
  bookmarks       Bookmark[]
  comments        Comment[]
  poll            Poll?
  hashtags        PostHashtag[]
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([authorId, createdAt])
  @@index([status, publishedAt])
  @@index([type, createdAt])
  @@index([isPinned])
  @@index([deletedAt])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  width     Int?
  height    Int?
  duration  Float?
  sortOrder Int       @default(0)

  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id         String        @id @default(cuid())
  postId     String
  authorId   String
  parentId   String?
  body       String
  likeCount  Int           @default(0)
  isPinned   Boolean       @default(false)
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]     @relation("CommentReplies")
  likes      CommentLike[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Poll {
  id       String       @id @default(cuid())
  postId   String       @unique
  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  endsAt   DateTime?
  options  PollOption[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  voteCount Int       @default(0)
  votes    PollVote[]
  sortOrder Int       @default(0)

  @@index([pollId, sortOrder])
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  userId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([optionId, userId])
  @@index([userId])
}

model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique
  postCount Int           @default(0)
  posts     PostHashtag[]
  createdAt DateTime      @default(now())

  @@index([postCount])
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    String?
  body      String?
  readAt    DateTime?
  user      User             @relation("NotifyUser", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotifyActor", fields: [actorId], references: [id])
  post      Post?            @relation(fields: [postId], references: [id])
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Story {
  id          String          @id @default(cuid())
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl    String
  mediaKind   MediaKind       @default(IMAGE)
  textOverlay String?
  viewCount   Int             @default(0)
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  views       StoryView[]
  reactions   StoryReaction[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
}

model Restrict {
  id           String   @id @default(cuid())
  restrictorId String
  restrictedId String
  restrictor   User     @relation("Restrictor", fields: [restrictorId], references: [id], onDelete: Cascade)
  restricted   User     @relation("Restricted", fields: [restrictedId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([restrictorId, restrictedId])
}

model PrivacySettings {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  whoCanFollow     PrivacyAudience @default(EVERYONE)
  whoCanMessage    PrivacyAudience @default(EVERYONE)
  whoCanCall       PrivacyAudience @default(FOLLOWERS)
  whoCanComment    PrivacyAudience @default(EVERYONE)
  whoCanMention    PrivacyAudience @default(EVERYONE)
  whoCanTag        PrivacyAudience @default(FOLLOWERS)
  whoCanSeeStories PrivacyAudience @default(FOLLOWERS)
  whoCanSeeActivity PrivacyAudience @default(FOLLOWERS)
  whoCanSeeOnline  PrivacyAudience @default(FOLLOWERS)
  showReadReceipts Boolean         @default(true)
  showTyping       Boolean         @default(true)
  updatedAt        DateTime        @updatedAt
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType     @default(DIRECT)
  title         String?
  image         String?
  coverImage    String?
  description   String?
  communityId   String?
  community     Community?           @relation(fields: [communityId], references: [id])
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       ConversationMember[]
  messages      Message[]
  calls         Call[]

  @@index([type, lastMessageAt])
  @@index([communityId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  isPinned       Boolean      @default(false)
  isMuted        Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isFavorite     Boolean      @default(false)
  unreadCount    Int          @default(0)
  draftText      String?
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived, lastReadAt])
  @@index([userId, isPinned])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType       @default(TEXT)
  body           String            @default("")
  mediaUrl       String?
  mediaMeta      Json?
  linkPreview    Json?
  replyToId      String?
  forwardedFromId String?
  isPinned       Boolean           @default(false)
  isEdited       Boolean           @default(false)
  isEncrypted    Boolean           @default(false)
  ciphertext     String?
  nonce          String?
  senderEphemeralKey String?
  delivery       MessageDelivery   @default(SENT)
  deletedForAll  Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  editedAt       DateTime?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]         @relation("MessageReplies")
  reactions      MessageReaction[]
  hides          MessageHide[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model MessageHide {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

model Call {
  id             String            @id @default(cuid())
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])
  callerId       String
  caller         User              @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  type           CallType          @default(AUDIO)
  status         CallStatus        @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime          @default(now())
  participants   CallParticipant[]

  @@index([callerId, createdAt])
  @@index([status, createdAt])
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  userId   String
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime?
  leftAt   DateTime?
  muted    Boolean   @default(false)
  cameraOff Boolean  @default(false)

  @@unique([callId, userId])
  @@index([userId])
}

model Community {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  description   String?
  rules         String?
  image         String?
  coverImage    String?
  visibility    CommunityVisibility  @default(PUBLIC)
  category      String?
  tags          String?
  ownerId       String
  owner         User                 @relation("CommunityOwner", fields: [ownerId], references: [id])
  membersCount  Int                  @default(1)
  postsCount    Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       CommunityMember[]
  posts         CommunityPost[]
  conversations Conversation[]

  @@index([visibility, membersCount])
  @@index([category])
  @@index([ownerId])
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole       @default(MEMBER)
  status      CommunityJoinStatus @default(JOINED)
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime            @default(now())

  @@unique([communityId, userId])
  @@index([userId, status])
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  body        String
  isPinned    Boolean   @default(false)
  isAnnouncement Boolean @default(false)
  mediaUrl    String?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, createdAt])
  @@index([communityId, isPinned])
  @@index([authorId])
}

// ─── Phase 4: Admin, settings, media, backups ───────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationRequest {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       VerificationRequestStatus @default(PENDING)
  fullName     String
  category     String
  evidenceUrls Json?
  notes        String?
  adminNote    String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum VerificationRequestStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  user      User     @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserWarning {
  id        String   @id @default(cuid())
  userId    String
  issuerId  String
  user      User     @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  issuer    User     @relation("WarningIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MediaAsset {
  id           String      @id @default(cuid())
  ownerId      String?
  owner        User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  kind         MediaKind
  originalUrl  String
  optimizedUrl String?
  thumbUrl     String?
  mimeType     String?
  sizeBytes    Int         @default(0)
  width        Int?
  height       Int?
  durationMs   Int?
  status       MediaStatus @default(READY)
  meta         Json?
  createdAt    DateTime    @default(now())

  @@index([ownerId, createdAt])
  @@index([kind, createdAt])
  @@index([status])
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

model BackupRecord {
  id         String       @id @default(cuid())
  type       BackupType
  scope      BackupScope
  status     BackupStatus @default(PENDING)
  path       String?
  sizeBytes  Int          @default(0)
  note       String?
  createdBy  String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  error      String?

  @@index([status, startedAt])
  @@index([type, startedAt])
}

enum BackupType {
  MANUAL
  DAILY
  WEEKLY
}

enum BackupScope {
  DATABASE
  MEDIA
  FULL
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("info")
  actorId   String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([actorId, createdAt])
}

model AnalyticsDaily {
  id              String   @id @default(cuid())
  date            DateTime @unique
  newUsers        Int      @default(0)
  activeUsers     Int      @default(0)
  posts           Int      @default(0)
  videos          Int      @default(0)
  stories         Int      @default(0)
  messages        Int      @default(0)
  communities     Int      @default(0)
  reports         Int      @default(0)
  createdAt       DateTime @default(now())
}
