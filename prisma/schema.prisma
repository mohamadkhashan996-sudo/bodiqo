generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local default: SQLite (no Docker required).
  // For production PostgreSQL, change provider to "postgresql" and set DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Key/value store config — PayPal, SMTP, shipping, currency, SEO, etc.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  enabled     Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  website              String?
  notes                String?
  defaultShippingDays  Int       @default(12)
  currency             String    @default("USD")
  enabled              Boolean   @default(true)
  products             Product[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String
  shortDescription   String
  price              Decimal
  compareAt          Decimal?
  costPrice          Decimal?
  currency           String           @default("ILS")
  sku                String           @unique
  barcode            String?
  vendor             String           @default("BODIQO")
  images             Json
  videoUrl           String?
  featured           Boolean          @default(false)
  enabled            Boolean          @default(true)
  inStock            Boolean          @default(true)
  inventory          Int              @default(100)
  weightGrams        Int?
  seoTitle           String?
  seoDescription     String?
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  /// Dropshipping / supplier
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id])
  supplierProductUrl String?
  supplierProductId  String?
  supplierSku        String?
  markupPercent      Decimal          @default(40)
  dropshipEnabled    Boolean          @default(true)
  lastCostSyncAt     DateTime?
  variants           ProductVariant[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([enabled, featured])
  @@index([categoryId])
  @@index([supplierId])
  @@index([supplierProductId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String
  sku          String   @unique
  options      Json?
  price        Decimal
  compareAt    Decimal?
  costPrice    Decimal?
  inventory    Int      @default(0)
  inStock      Boolean  @default(true)
  image        String?
  supplierSku  String?
  supplierUrl  String?
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  type          DiscountType
  value         Decimal
  minSubtotal   Decimal?
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  email             String
  status            OrderStatus @default(PENDING)
  subtotal          Decimal
  shipping          Decimal
  discount          Decimal     @default(0)
  total             Decimal
  currency          String      @default("ILS")
  couponCode        String?
  shippingName      String
  shippingPhone     String?
  shippingAddress   String
  shippingCity      String
  shippingZip       String?
  shippingCountry   String      @default("IL")
  trackingNumber    String?
  carrier           String?
  shippedAt         DateTime?
  notes             String?
  paypalOrderId      String?
  paypalCaptureId    String?
  paidAt             DateTime?
  /// Dropship fulfillment: UNFULFILLED | ORDERED_SUPPLIER | SHIPPED | DELIVERED
  fulfillStatus      String      @default("UNFULFILLED")
  supplierOrderId    String?
  supplierOrderedAt  DateTime?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@index([fulfillStatus])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  variantId   String?
  title       String
  slug        String
  image       String?
  price       Decimal
  quantity    Int
  costPrice   Decimal?
  supplierUrl String?
  supplierSku String?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  title     String?
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, approved])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  href      String
  sortOrder Int        @default(0)
  enabled   Boolean    @default(true)
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  location  String     @default("header")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int       @default(0)
  enabled   Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ImportJob {
  id         String   @id @default(cuid())
  source     String
  status     String   @default("pending")
  totalRows  Int      @default(0)
  successRows Int     @default(0)
  errorRows  Int      @default(0)
  log        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
