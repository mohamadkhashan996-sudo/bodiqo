# Local SQLite (works without Docker)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (recommended) — also start docker compose:
# DATABASE_URL="postgresql://bodiqo:bodiqo@localhost:5432/bodiqo?schema=public"
# Then set prisma provider to "postgresql" in prisma/schema.prisma

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloudinary (otherwise local /public/uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe / PayPal / Crypto wallets are configured in Admin → Payments (database),
# not required here. Stripe webhook secret can also live in Admin settings.
