# Cirqua — environment template
# Copy to .env for local development

# Local Phase 1 (SQLite)
DATABASE_URL="file:./dev.db"

# Production / Docker Postgres example:
# DATABASE_URL="postgresql://cirqua:cirqua@localhost:5432/cirqua?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth — configure only the providers you enable in production.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Apple service ID and generated client secret:
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
# Microsoft Entra application (AUTH_MICROSOFT_ID is also accepted):
AUTH_MICROSOFT_ENTRA_ID=""
AUTH_MICROSOFT_ENTRA_SECRET=""

# Redis (Phase 2+)
REDIS_URL="redis://localhost:6379"

# Media (Phase 2+)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# UPLOADTHING_TOKEN=
