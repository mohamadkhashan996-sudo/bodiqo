{
  "name": "relune",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:clean": "rm -rf .next && tsx watch server.ts",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:phase2": "tsx prisma/seed-phase2.ts",
    "db:seed:phase3": "tsx prisma/seed-phase3.ts",
    "db:seed:phase4": "tsx prisma/seed-phase4.ts",
    "db:seed:official": "tsx prisma/seed-official.ts",
    "db:setup:official": "bash scripts/setup-official-account.sh",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:verify": "tsx scripts/verify-platform.ts",
    "test:prelaunch": "tsx scripts/prelaunch-audit.ts",
    "test:critical": "tsx scripts/critical-probe.ts",
    "test:auth:email": "tsx scripts/test-auth-flow.ts",
    "test:auth:phone": "tsx scripts/test-phone-auth-flow.ts",
    "test:realtime": "tsx scripts/test-realtime-auth-flow.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "bash scripts/backup.sh",
    "backup:restore": "bash scripts/restore.sh",
    "up": "bash scripts/dev-up.sh",
    "prebuild": "prisma generate",
    "release:check": "bash scripts/release-check.sh",
    "mobile:add": "npx cap add ios; npx cap add android",
    "mobile:sync": "bash scripts/mobile-sync.sh",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "mobile:copy": "npx cap copy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.525.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.29",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-international-phone": "^4.8.0",
    "redis": "^6.1.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^7.6.8",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
